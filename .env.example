# PostgreSQL connection string supplied by PMA IT / database administrator
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pma_cadets?schema=public"

# Administrator credentials for the application login
ADMIN_USERNAME="pma-admin"
ADMIN_PASSWORD="replace-with-a-long-unique-password"

# Generate a random secret of at least 32 characters. Never commit the real value.
SESSION_SECRET="replace-with-at-least-32-random-characters"
