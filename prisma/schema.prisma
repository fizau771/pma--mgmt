generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Cadet {
  id        String   @id @default(cuid()) @db.VarChar(191)
  roll      String   @unique @db.VarChar(191)
  name      String   @db.VarChar(191)
  company   String   @db.VarChar(191)
  platoon   String   @db.VarChar(191)
  term      String?  @db.VarChar(191)
  courses   Json
  marks     Json
  status    String?  @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([company, platoon, term])
  @@index([status])
}
